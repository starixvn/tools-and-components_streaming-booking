@using StreamingBooking.Services
@using System.Configuration
@{
    ViewBag.Title = "Search";
    Layout = null;

}
@model StreamingBooking.Models.StreamViewModel
@if (Model.DistinctStreams != null && Model.DistinctStreams.Any())
{
    int counter = 0;
    var activeRowClass = string.Empty;
    var oddRowClass = string.Empty;
    var clientTimeZone = Convert.ToInt32(ConfigurationManager.AppSettings["ClientTimeZone"]);

    foreach (var item in Model.DistinctStreams)
    {
        counter++;
        activeRowClass = item.IsActive ? "active" : string.Empty;
        oddRowClass = counter % 2 == 0 ? "odd" : string.Empty;
        <tr class="@(oddRowClass) @(activeRowClass)" data-stream-id="@item.StreamId">
            <td>
                @item.StreamId
            </td>
            <td>
                @item.KickOffDate.ToString("MM/dd/yyyy") 
            </td>
            <td>
                @item.KickOffDate.ToString("HH:mm") GMT+@clientTimeZone
            </td>
            <td align="center">
                @item.SportName
            </td>
            <td align="center">
                @item.LeagueName
            </td>
            <td>
                @item.HomeName
            </td>
            <td>
                @item.AwayName
            </td>
            <td align="center">
                @if (Model.AllStreams.Any(x => x.StreamId == item.StreamId && x.IBCBet))
                {
                    <span>Booked</span>
                }
            </td>
            <td align="center">
                @if (Model.AllStreams.Any(x => x.StreamId == item.StreamId && x.Dafabet))
                {
                    <span>Booked</span>
                }
            </td>
            <td align="center">
                @if (Model.AllStreams.Any(x => x.StreamId == item.StreamId && x.M88))
                {
                    <span>Booked</span>
                }
            </td>
            <td align="center">
                @if (Model.AllStreams.Any(x => x.StreamId == item.StreamId && x.Fun88))
                {
                    <span>Booked</span>
                }
            </td>
            <td align="center">
                @if (Model.AllStreams.Any(x => x.StreamId == item.StreamId && x.ALog))
                {
                    <span>Booked</span>
                }
            </td>
            <td align="center">
                @if (Model.AllStreams.Any(x => x.StreamId == item.StreamId && x.Mayfair))
                {
                    <span>Booked</span>
                }
            </td>
            <td>
                @Html.TextBox("remark", item.Remark)
            </td>
        </tr>
    }
}
else
{
    <tr>
        <td colspan="8">
            No information
        </td>
    </tr>
}