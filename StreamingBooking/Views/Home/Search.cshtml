@using StreamingBooking.Services
@using System.Configuration
@{
    ViewBag.Title = "Search";
    Layout = null;

    var activeRows = StreamingBooking.Helper.ReadFile(ConfigurationManager.AppSettings["StreamingPath"]);
    var remarks = StreamingBooking.Helper.ReadRemarkFile(ConfigurationManager.AppSettings["StreamingRemarkPath"]);
}
@model StreamingBooking.Models.StreamViewModel
@if (Model.Streams.Count != 0)
{
    int counter = 0;
    var activeRowClass = string.Empty;
    var oddRowClass = string.Empty;

    foreach (var item in Model.Streams)
    {
        counter++;
        activeRowClass = activeRows.Contains(item.StreamId.ToString()) ? "active" : string.Empty;
        oddRowClass = counter % 2 == 0 ? "odd" : string.Empty;
    <tr class="@(oddRowClass) @(activeRowClass)" data-stream-id="@item.StreamId">
        <td>
            @item.StreamId
        </td>
        <td>
            @item.KickOffDate.ToString("MM/dd/yyyy")
        </td>
        <td align="center">
            @item.SportName
        </td>
        <td align="center">
            @item.LeagueName
        </td>
        <td>
            @item.HomeName
        </td>
        <td>
            @item.AwayName
        </td>
        <td align="center">
            @if (item.IBCBet)
            { 
                <span>Booked</span>
            }
        </td>
        <td align="center">
            @if (item.Bodog)
            { 
                <span>Booked</span>
            }
        </td>
        <td align="center">
            @if (item.Dafabet)
            { 
                <span>Booked</span>
            }
        </td>
        <td align="center">
            @if (item.Fun88)
            { 
                <span>Booked</span>
            }
        </td>
        <td align="center">
            @if (item.Macaubet)
            { 
                <span>Booked</span>
            }
        </td>
        <td align="center">
            @if (item.TLC)
            { 
                <span>Booked</span>
            }
        </td>
        <td align="center">
            @if (item.ALog)
            { 
                <span>Booked</span>
            }
        </td>
        <td align="center">
            @if (item.Mayfair)
            { 
                <span>Booked</span>
            }
        </td>
        <td>
            @Html.TextBox("remark", remarks.Keys.Contains(item.StreamId) ? remarks[item.StreamId] : string.Empty)
        </td>
    </tr>
    }
}
else
{ 
    <tr>
        <td colspan="8">
            No information
        </td>
    </tr>
}