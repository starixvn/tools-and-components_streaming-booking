@{
    ViewBag.Title = "Index";
    List<SelectListItem> autoRefresh = new List<SelectListItem>();

    autoRefresh.Add(new SelectListItem
    {
        Text = "5",
        Value = "5"
    });

    autoRefresh.Add(new SelectListItem
    {
        Text = "10",
        Value = "10"
    });

    autoRefresh.Add(new SelectListItem
    {
        Text = "15",
        Value = "15"
    });


    var request = HttpContext.Current.Request;
    var appUrl = HttpRuntime.AppDomainAppVirtualPath;

    if (appUrl != "/")
    {
        appUrl += "/";
    }

    var baseUrl = string.Format("{0}://{1}{2}", request.Url.Scheme, request.Url.Authority, appUrl);
}
@model StreamingBooking.Models.StreamViewModel
@section scripts{
    @Scripts.Render("~/bundles/site")
    <script type="text/ecmascript">
        var baseUrl = '@baseUrl';

        $(document).ready(function () {
            SITE.initialize(baseUrl);
        });
    </script>
}
<div class="filter">
    <table cellspacing="10">
        <tr>
            <td class="lable">
                Provider
            </td>
            <td class="text">
                @Html.DropDownList("providers", new SelectList(Model.Providers, "Value", "Text"))
            </td>
            <td class="lable">
                Licensee
            </td>
            <td class="text">
                @Html.DropDownList("licensees", new SelectList(Model.Licensees))
            </td>
            <td class="lable">
                Leagues
            </td>
            <td class="text">
                @Html.DropDownList("leagues", new SelectList(Model.Leagues))
            </td>
        </tr>
        <tr>
            <td class="lable">
                From
            </td>
            <td class="text">
                @Html.DropDownList("fromDate", new SelectList(Model.From))
            </td>
            <td class="lable">
                To
            </td>
            <td class="text">
                @Html.DropDownList("toDate", new SelectList(Model.To))
            </td>
            <td class="label">
                Sports
            </td>
            <td class="text">
                @Html.DropDownList("sports", new SelectList(Model.Sports))
            </td>
            <td class="lable">
                Auto Refresh
            </td>
            <td class="text">
                @Html.DropDownList("auto-refresh", autoRefresh)
                <button id="btnSubmit" name="btnSubmit" class="btnSubmit" type="button">
                    Search
                </button>
            </td>
        </tr>
    </table>
</div>
<div class="container">
    <table id="tbl-stream" class="tbl-data">
        <thead>
            <tr>
                <th>
                    StreamId
                </th>
                <th>
                    Date
                </th>
                <th>
                    Sport
                </th>
                <th>
                    League
                </th>
                <th>
                    Team A
                </th>
                <th>
                    Team B
                </th>
                <th>
                    IBCBet
                </th>               
                <th>
                    Dafabet
                </th>
                <th>
                    M88
                </th>
                <th>
                    Fun88
                </th>               
                <th>
                    ALog
                </th>
                <th>
                    Mayfair
                </th>
                <th>
                    Remark
                </th>
            </tr>
        </thead>
        <tbody id="data-contain">
        </tbody>
    </table>
</div>
